<%- include('../partials/head') %>
<div class="container">
  <header class="page-head">
    <p class="eyebrow">Travel guide · India</p>
    <h1><%= (state.content && state.content.h1) || (state.name + ' travel guide') %></h1>
  </header>
  <%- include('../partials/content', { content: state.content }) %>

  <% if (cities.length) { %>
  <section class="block">
    <h2>Destinations in <%= state.name %></h2>
    <nav class="chips">
      <% cities.forEach(function (c) { %>
        <a class="chip" href="<%= c.hasHotels ? paths.cityHotels(state, c) : paths.cityBlog(state, c) %>"><%= c.hasHotels ? 'Hotels in ' + c.name : c.name + ' guide' %></a>
      <% }) %>
    </nav>
  </section>
  <% } %>

  <% if (articles.length) { %>
  <section class="block">
    <h2>Latest guides</h2>
    <div class="grid cards-3">
      <% articles.forEach(function (a) { %>
        <a class="card" href="<%= paths.article(state, a.city, a) %>">
          <% if (a.coverImage && a.coverImage.url) { %><img src="<%= a.coverImage.url %>" alt="<%= a.coverImage.alt || a.title %>" loading="lazy" width="400" height="240" /><% } %>
          <div class="card-body"><h3><%= a.title %></h3><% if (a.excerpt) { %><p class="muted clamp-2"><%= a.excerpt %></p><% } %></div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>
</div>
<%- include('../partials/footer') %>
