<article class="card hotel-card">
  <a href="<%= url %>" class="card-media">
    <% if (h.heroImage && h.heroImage.url) { %>
      <img src="<%= h.heroImage.url %>" alt="<%= h.heroImage.alt || h.name %>" loading="lazy" width="400" height="260" />
    <% } else { %><div class="img-placeholder"></div><% } %>
  </a>
  <div class="card-body">
    <h3><a href="<%= url %>"><%= h.name %></a></h3>
    <% if (h.starRating) { %><div class="stars" aria-label="<%= h.starRating %> star"><%- include('stars', { count: h.starRating }) %></div><% } %>
    <% if (h.shortDescription) { %><p class="muted clamp-2"><%= h.shortDescription %></p><% } %>
    <% if (h.priceFrom) { %><p class="price">from <b><%= fmt(h.priceFrom) %></b> / night</p><% } %>
  </div>
</article>
