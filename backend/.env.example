# ───────── Core ─────────
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/lexatrip
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (short — the client renews it silently with the refresh token)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime per audience (sliding: every use issues a new one). Admin = 1 day.
REFRESH_TTL_DAYS_USER=30
REFRESH_TTL_DAYS_VENDOR=30
REFRESH_TTL_DAYS_ADMIN=1

# Public URLs
# SITE_URL is the canonical public origin used in sitemaps, canonical tags and schema markup.
SITE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for the API
CLIENT_ORIGINS=http://localhost:5173

# When true, Express also serves the built React app (frontend/dist) — single-process monolith deploy
SERVE_FRONTEND=false

# ───────── Auth / OTP ─────────
# In development with no SMS provider configured, OTP is always DEV_OTP and is returned in the API response.
DEV_OTP=123456
OTP_PROVIDER=console          # console | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ───────── Email (SMTP) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LexaTrip <no-reply@lexatrip.com>"

# ───────── Payments ─────────
PAYMENT_PROVIDER=mock         # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───────── AI (guest assistant + admin SEO writer) ─────────
AI_PROVIDER=gemini            # gemini | none  (none = built-in rule-based fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ───────── Travel APIs (subject to provider approval) ─────────
BUS_PROVIDER=mock             # mock | <real adapter name once contracted>
FLIGHT_PROVIDER=mock
CHANNEL_MANAGER_PROVIDER=mock # mock | staah | axisrooms

# ───────── Google Search Console ─────────
# Absolute path to a service-account JSON that has been added as an owner/user of the GSC property.
GSC_SERVICE_ACCOUNT_FILE=
GSC_SITE_URL=                 # e.g. sc-domain:lexatrip.com  or  https://lexatrip.com/

# ───────── Seed accounts ─────────
SEED_ADMIN_EMAIL=admin@lexatrip.com
SEED_ADMIN_PASSWORD=Admin@123

# Shared secret expected in X-Channel-Secret on channel-manager webhooks
CHANNEL_WEBHOOK_SECRET=

# ───────── Security & scaling ─────────
# Number of reverse proxies in front of Node (Nginx / load balancer = 1, direct = 0). Required for correct client IPs in rate limiting.
TRUST_PROXY=1
# 0 = single process (dev) · N = N cluster workers · -1 = one per CPU core
CLUSTER_WORKERS=0

# ───────── Rate limiting (all tunable) ─────────
RATE_LIMIT_ENABLED=true            # false = disable (never in production)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GLOBAL=300              # all API calls per window per IP
RATE_LIMIT_WRITE=90                # POST/PUT/PATCH/DELETE per window per IP
RATE_LIMIT_LOGIN_MAX=10            # failed logins per IP+account
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_OTP_MAX=6               # OTP requests per IP+phone
RATE_LIMIT_OTP_WINDOW_MIN=15
RATE_LIMIT_OTP_IP_MAX=30           # OTP requests per hour per IP
RATE_LIMIT_UPLOAD_MAX=60           # uploads per 10 minutes
RATE_LIMIT_AI_MAX=20               # Lexa AI calls per window
RATE_LIMIT_REFRESH_MAX=60          # token refreshes per 15 min per IP
RATE_LIMIT_LIVE_MAX=30             # live-update stream connections per window per IP

# ───────── MongoDB tuning ─────────
MONGO_MAX_POOL=20
MONGO_MIN_POOL=2
# Build indexes at boot (default: true in dev, false in production → run `npm run indexes` on deploy)
MONGO_AUTO_INDEX=true

# Public DNS used if your network refuses the mongodb+srv DNS lookup (querySrv EREFUSED)
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
