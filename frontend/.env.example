# Leave empty in development (Vite proxies /api to the backend).
# In production set to the API origin if it differs from the site, e.g. https://api.lexatrip.com
VITE_API_URL=
# Backend URL used by the Vite dev proxy
VITE_BACKEND_URL=http://localhost:5001

# Push notifications — Firebase console → Project settings → General (web app config) and Cloud Messaging (Web Push key).
# These are public values. Never put the service-account key in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
